.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary {
  font-size: 26rpx;
  color: #047857;
  margin-bottom: 20rpx;
}

.summary.running {
  color: #b45309;
}

.btn {
  margin: 0 0 24rpx;
  font-size: 28rpx;
}

.list {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.line {
  display: block;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.7;
  word-break: break-all;
  color: #1f2937;
}
