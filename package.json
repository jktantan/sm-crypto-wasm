{
  "name": "sm-crypto-wasm",
  "version": "0.7.0",
  "description": "SM2/SM3/SM4/SM9/ZUC (Chinese cryptography) implemented in AssemblyScript → WebAssembly. Node.js 18+ and modern browsers, with per-algorithm lazy loading.",
  "keywords": [
    "sm2",
    "sm3",
    "sm4",
    "sm9",
    "zuc",
    "sm-crypto",
    "chinese-cryptography",
    "gm",
    "gmssl",
    "cryptography",
    "encryption",
    "webassembly",
    "wasm",
    "assemblyscript",
    "x509",
    "cms",
    "webcrypto",
    "typescript",
    "国密",
    "商密"
  ],
  "homepage": "https://jktantan.github.io/sm-crypto-wasm/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jktantan/sm-crypto-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/jktantan/sm-crypto-wasm/issues"
  },
  "author": "jktantan",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/runtime/loadWasm.js": "./dist/runtime/loadWasm.browser.js",
    "./dist/runtime/random.js": "./dist/runtime/random.browser.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sm2": {
      "types": "./dist/sm2/index.d.ts",
      "import": "./dist/sm2/index.js",
      "default": "./dist/sm2/index.js"
    },
    "./sm3": {
      "types": "./dist/sm3/index.d.ts",
      "import": "./dist/sm3/index.js",
      "default": "./dist/sm3/index.js"
    },
    "./sm4": {
      "types": "./dist/sm4/index.d.ts",
      "import": "./dist/sm4/index.js",
      "default": "./dist/sm4/index.js"
    },
    "./sm9": {
      "types": "./dist/sm9/index.d.ts",
      "import": "./dist/sm9/index.js",
      "default": "./dist/sm9/index.js"
    },
    "./zuc": {
      "types": "./dist/zuc/index.d.ts",
      "import": "./dist/zuc/index.js",
      "default": "./dist/zuc/index.js"
    },
    "./x509": {
      "types": "./dist/x509/index.d.ts",
      "import": "./dist/x509/index.js",
      "default": "./dist/x509/index.js"
    },
    "./cms": {
      "types": "./dist/cms/index.d.ts",
      "import": "./dist/cms/index.js",
      "default": "./dist/cms/index.js"
    },
    "./webcrypto": {
      "types": "./dist/webcrypto/index.d.ts",
      "import": "./dist/webcrypto/index.js",
      "default": "./dist/webcrypto/index.js"
    },
    "./esbuild-plugin": {
      "types": "./dist/esbuild-plugin.d.ts",
      "import": "./dist/esbuild-plugin.js",
      "default": "./dist/esbuild-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && pnpm build:wasm:all && pnpm build:ts",
    "build:wasm:sm3": "asc src/sm3/assembly/index.ts --outFile dist/sm3/sm3.wasm --optimize",
    "build:wasm:sm2": "asc src/sm2/assembly/index.ts --outFile dist/sm2/sm2.wasm --optimize",
    "build:wasm:sm4": "asc src/sm4/assembly/index.ts --outFile dist/sm4/sm4.wasm --optimize",
    "build:wasm:sm9": "asc src/sm9/assembly/index.ts --outFile dist/sm9/sm9.wasm --optimize",
    "build:wasm:zuc": "asc src/zuc/assembly/index.ts --outFile dist/zuc/zuc.wasm --optimize",
    "build:wasm:all": "pnpm run build:wasm:sm2 && pnpm run build:wasm:sm3 && pnpm run build:wasm:sm4 && pnpm run build:wasm:sm9 && pnpm run build:wasm:zuc",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:ts:debug": "tsc -p tsconfig.build.debug.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true,maxRetries:3,retryDelay:100})\"",
    "test": "pnpm run build:wasm:all && pnpm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "pnpm run build:wasm:all && vitest run --config vitest.browser.config.ts",
    "test:fuzz": "pnpm run build:wasm:all && vitest run --config vitest.fuzz.config.ts",
    "lint": "biome check src tests bench",
    "format": "biome format --write src tests bench",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.ts",
    "bench:cubelrti": "tsx bench/compare-cubelrti.bench.ts",
    "docs:dev": "pnpm build && vitepress dev website",
    "docs:build": "pnpm build && vitepress build website",
    "docs:preview": "vitepress preview website",
    "example:wechat:prepare": "node examples/wechat-miniprogram/scripts/prepare.mjs",
    "prepack": "pnpm build && pnpm run test:unit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "assemblyscript": "^0.28.20",
    "fast-check": "^4.10.2",
    "gmkitx": "^0.10.1",
    "happy-dom": "21.0.1",
    "mitata": "^1.0.34",
    "release-it": "^21.1.1",
    "sm-crypto-v2": "1.15.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
